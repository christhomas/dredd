save-exact

# pnpm 10 resolves a workspace dependency from the registry unless told otherwise, so
# packages/dredd was installing a published dredd-transactions instead of the sibling it is
# released with - and a version bump could not resolve until that version existed on npm.
# The dependency stays a plain semver range rather than workspace:^, because the publish
# workflow uses npm, which does not understand that protocol and would publish it verbatim.
link-workspace-packages=true
