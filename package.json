{
  "private": true,
  "scripts": {
    "build": "pnpm -r run build",
    "prettify:check": "pnpm --filter @antimatter-studios/dredd run prettify:check",
    "docs:lint": "sphinx-build -nW -b linkcheck ./docs ./docs/_build",
    "docs:test-extensions": "python -m unittest docs/_extensions/*.py --verbose",
    "docs:build": "sphinx-build -nW -b html ./docs ./docs/_build",
    "docs:serve": "sphinx-autobuild ./docs ./docs/_build",
    "lint": "pnpm -r --if-present run lint",
    "test:smoke": "pnpm -r --if-present run test:smoke",
    "test": "pnpm -r --if-present run test",
    "commit:lint": "commitlint --from HEAD~1 --to HEAD",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "packages/dredd/**/*.js": "pnpm --filter @antimatter-studios/dredd exec eslint --fix",
    "packages/dredd-transactions/**/*.js": "pnpm --filter @antimatter-studios/dredd-transactions exec eslint --fix"
  },
  "pnpm": {
    "onlyBuiltDependencies": []
  }
}
