{
  "private": true,
  "scripts": {
    "build": "npm run build --workspaces",
    "prettify:check": "npm run prettify:check --workspace=@antimatter-studios/dredd",
    "docs:lint": "sphinx-build -nW -b linkcheck ./docs ./docs/_build",
    "docs:test-extensions": "python -m unittest docs/_extensions/*.py --verbose",
    "docs:build": "sphinx-build -nW -b html ./docs ./docs/_build",
    "docs:serve": "sphinx-autobuild ./docs ./docs/_build",
    "lint": "npm run lint --workspaces --if-present",
    "test:smoke": "npm run test:smoke --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "commit:lint": "commitlint --from HEAD~1 --to HEAD",
    "prepare": "husky"
  },
  "devDependencies": {
    "@changesets/cli": "^2.29.4",
    "@commitlint/cli": "19.8.1",
    "@commitlint/config-conventional": "19.8.1",
    "husky": "9.1.7",
    "lint-staged": "15.5.2"
  },
  "workspaces": [
    "packages/*"
  ],
  "lint-staged": {
    "packages/dredd/**/*.js": "eslint --fix",
    "packages/dredd-transactions/**/*.js": "eslint --fix"
  }
}
