{
  "name": "@antimatter-studios/dredd-transactions",
  "version": "12.0.0",
  "description": "Compiles HTTP Transactions (Request-Response pairs) from an API description document",
  "main": "index.js",
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=20.19"
  },
  "scripts": {
    "prepack": "node ./scripts/prepack.cjs",
    "postpack": "node ./scripts/postpack.cjs",
    "build": "exit 0",
    "clean": "rimraf ./coverage",
    "lint": "eslint .",
    "pretest": "node ./scripts/pretest.cjs",
    "test": "npm run clean && mocha ./test",
    "test:coverage": "npm run clean && nyc mocha ./test",
    "test:smoke": "bash ./scripts/smoke.sh"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/antimatter-studios/dredd.git"
  },
  "files": [
    "index.js",
    "parse",
    "compile",
    "README.md"
  ],
  "dependencies": {
    "@antimatter-studios/openapi3-parser": "0.17.2",
    "@apielements/apib-parser": "0.20.1",
    "@apielements/core": "^0.2.1",
    "@apielements/openapi2-parser": "0.32.6",
    "uri-template": "1.0.1"
  },
  "bundledDependencies": [
    "@apielements/apib-parser"
  ],
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "26.2.0",
    "@types/ramda": "0.32.0",
    "chai": "6.2.2",
    "chai-json-schema": "1.5.1",
    "eslint": "9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "esmock": "2.7.6",
    "globals": "^16.5.0",
    "mocha": "^11.8.0",
    "mocha-lcov-reporter": "1.3.0",
    "nyc": "18.0.0",
    "proxyquire": "2.1.3",
    "rimraf": "6.1.3",
    "sinon": "22.1.0",
    "ts-toolbelt": "9.6.0",
    "typescript": "5.4.5"
  },
  "keywords": [
    "api",
    "test",
    "testing",
    "documenation",
    "integration",
    "acceptance"
  ],
  "original_author": "Apiary Czech Republic, s.r.o. <support@apiary.io>",
  "author": "Chris Thomas <chris.thomas@antimatter-studios.com>",
  "license": "MIT",
  "homepage": "https://github.com/antimatter-studios/dredd/tree/master/packages/dredd-transactions",
  "fork": "antimatter-studios/dredd",
  "bundleDependencies": [
    "@apielements/apib-parser"
  ],
  "exports": {
    ".": "./index.js",
    "./parse": "./parse/index.js",
    "./compile": "./compile/index.js",
    "./package.json": "./package.json"
  }
}
